DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/aftermath_ai
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5176
# Razorpay Dashboard -> Test Mode -> Account & Settings -> API Keys
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET

# Discord bot delivery (preferred). Keep real values only in backend/.env.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=1565637655461367859
# Optional fallback; do not use a bot token as a webhook URL.
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_TIMEOUT=8

# Shared secret between FastAPI and the separately running Switch recovery agent.
# Generate with: openssl rand -hex 32. Use the same value in both processes.
DISCORD_RECOVERY_AGENT_KEY=
DISCORD_SUPPORT_INVITE_URL=https://discord.gg/6sCDwusbw
# Public origin of the deployed React storefront; used in corrected shipment links.
PUBLIC_FRONTEND_URL=http://localhost:5173

# Switch agent client settings (set in the agent runner environment, not the browser).
SWITCH_BRIDGE_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_ID=
SWITCH_CONNECTION_ID=
AFTERMATH_API_BASE_URL=http://127.0.0.1:8000
